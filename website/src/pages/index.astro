---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Timeline from '../components/sections/Timeline.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import DetectionCatalog from '../components/sections/DetectionCatalog.astro';
import UseCases from '../components/sections/UseCases.astro';
import Comparison from '../components/sections/Comparison.astro';
import ApiTeaser from '../components/sections/ApiTeaser.astro';
import Trust from '../components/sections/Trust.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
import StickyCta from '../components/sections/StickyCta.astro';
import { content } from '../content/tr';
---

<Base title={content.meta.title} description={content.meta.description} lang={content.meta.lang}>
  <Header brand={content.meta.brand} />
  <main>
    <Hero hero={content.hero} />
    <Problem problem={content.problem} />
    <Timeline timeline={content.timeline} />
    <HowItWorks howItWorks={content.howItWorks} />
    <DetectionCatalog detectionCatalog={content.detectionCatalog} />
    <UseCases useCases={content.useCases} />
    <Comparison comparison={content.comparison} />
    <ApiTeaser apiTeaser={content.apiTeaser} />
    <Trust trust={content.trust} />
    <Faq faq={content.faq} />
    <FinalCta finalCta={content.finalCta} />
  </main>
  <Footer brand={content.meta.brand} footer={content.footer} />
  <StickyCta />
</Base>
