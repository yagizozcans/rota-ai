---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { content } from '../content/tr';
---

<Base
  title={`Teşekkürler — ${content.meta.brand}`}
  description="Demo talebiniz alındı."
  lang={content.meta.lang}
>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-start justify-center px-6 py-24">
    <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-ok-400 text-xl font-bold text-ink-950">
      ✓
    </span>
    <h1 class="text-4xl font-bold tracking-tight">Talebiniz alındı.</h1>
    <p class="mt-4 text-lg text-ink-300">
      Demo talebiniz için teşekkürler. Ekibimiz en kısa sürede sizinle iletişime geçecek.
    </p>
    <Button href="/" class="mt-8">Ana sayfaya dön</Button>
  </main>
</Base>
