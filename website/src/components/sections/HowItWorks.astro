---
import Section from '../ui/Section.astro';
import type { SiteContent } from '../../content/schema';
interface Props {
  howItWorks: SiteContent['howItWorks'];
}
const { howItWorks } = Astro.props;
---

<Section id="nasil-calisir" class="border-t border-ink-800">
  <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{howItWorks.title}</h2>
  <p class="mt-4 max-w-2xl text-lg text-ink-300">{howItWorks.intro}</p>
  <ol class="mt-10 grid gap-6 md:grid-cols-4">
    {
      howItWorks.steps.map((s) => (
        <li class="rounded-xl border border-ink-800 bg-ink-900 p-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 font-bold text-ink-950">
            {s.n}
          </span>
          <h3 class="mt-4 font-semibold text-ink-100">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-300">{s.body}</p>
        </li>
      ))
    }
  </ol>
  <p class="mt-8 rounded-lg border border-brand-600/30 bg-brand-600/10 px-5 py-4 text-sm text-ink-100">
    {howItWorks.humanNote}
  </p>
</Section>
