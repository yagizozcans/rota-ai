---
import Section from '../ui/Section.astro';
import type { SiteContent } from '../../content/schema';
interface Props {
  problem: SiteContent['problem'];
}
const { problem } = Astro.props;
---

<Section class="border-t border-ink-800">
  <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{problem.title}</h2>
  <p class="mt-4 max-w-2xl text-lg text-ink-300">{problem.intro}</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      problem.pains.map((p) => (
        <div class="rounded-xl border border-ink-800 bg-ink-900 p-6">
          <h3 class="font-semibold text-ink-100">{p.title}</h3>
          <p class="mt-2 text-sm text-ink-300">{p.body}</p>
        </div>
      ))
    }
  </div>
</Section>
