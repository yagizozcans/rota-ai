---
/** Sticky demo CTA (#7) — slides up after the hero, dismissible. */
---
<div id="sticky-cta" class="sticky-cta" data-hidden>
  <span class="sticky-cta__text">Yol envanterinizi yapay zeka ile çıkarın — özel donanım yok.</span>
  <a href="#demo" class="sticky-cta__btn">Demo Talep Et</a>
  <button type="button" class="sticky-cta__x" aria-label="Kapat">✕</button>
</div>

<style>
  .sticky-cta {
    position: fixed; left: 50%; bottom: 20px; z-index: 50;
    transform: translate(-50%, 140%);
    display: flex; align-items: center; gap: 14px;
    max-width: calc(100% - 24px);
    padding: 10px 12px 10px 20px;
    border: 1px solid var(--color-brand-600);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink-900) 88%, transparent);
    box-shadow: 0 20px 50px -20px color-mix(in oklab, var(--color-brand-500) 70%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
  }
  .sticky-cta:not([data-hidden]) { transform: translate(-50%, 0); opacity: 1; }
  .sticky-cta__text { font-size: 13px; color: var(--color-ink-100); }
  .sticky-cta__btn {
    flex: none; border-radius: 999px; padding: 8px 16px;
    font-size: 13px; font-weight: 600; white-space: nowrap;
    background: var(--color-brand-500); color: var(--color-ink-950);
    transition: background 0.2s ease;
  }
  .sticky-cta__btn:hover { background: var(--color-brand-400); }
  .sticky-cta__x {
    flex: none; width: 26px; height: 26px; border-radius: 999px;
    border: 1px solid var(--color-ink-700); background: transparent;
    color: var(--color-ink-300); font-size: 12px; cursor: pointer; line-height: 1;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .sticky-cta__x:hover { color: var(--color-ink-100); border-color: var(--color-ink-500); }
  @media (max-width: 560px) { .sticky-cta__text { display: none; } }
</style>

<script>
  const el = document.getElementById('sticky-cta');
  if (el) {
    let dismissed = false;
    const sync = () => {
      if (dismissed) return;
      // show past the hero; hide again once the demo form is in view (no dupe CTA)
      const demo = document.getElementById('demo');
      const nearDemo = demo ? demo.getBoundingClientRect().top < window.innerHeight : false;
      const show = window.scrollY > 640 && !nearDemo;
      el.toggleAttribute('data-hidden', !show);
    };
    el.querySelector('.sticky-cta__x')?.addEventListener('click', () => {
      dismissed = true;
      el.setAttribute('data-hidden', '');
    });
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
