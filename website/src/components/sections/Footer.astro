---
import type { SiteContent } from '../../content/schema';
interface Props {
  brand: string;
  footer: SiteContent['footer'];
}
const { brand, footer } = Astro.props;
---

<footer class="border-t border-ink-800 px-6 py-12 md:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <div class="flex items-center gap-2 font-bold">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-500"></span>
        {brand}
      </div>
      <p class="mt-3 text-sm text-ink-300">{footer.tagline}</p>
    </div>
    <nav class="flex flex-col gap-2 text-sm text-ink-300">
      {footer.links.map((l) => <a href={l.href} class="hover:text-ink-100">{l.label}</a>)}
    </nav>
  </div>
  <p class="mx-auto mt-8 max-w-6xl text-xs text-ink-500">{footer.legal}</p>
</footer>
