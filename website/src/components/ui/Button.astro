---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { href, variant = 'primary', class: klass = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-lg px-6 py-3 text-sm font-semibold transition-colors';
const styles =
  variant === 'primary'
    ? 'bg-brand-500 text-ink-950 hover:bg-brand-400'
    : 'border border-ink-700 text-ink-100 hover:bg-ink-800';
---

<a href={href} class={`${base} ${styles} ${klass}`}><slot /></a>
