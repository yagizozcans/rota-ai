---
/**
 * Signature hero animation — the RotaAI pipeline as one looping instrument:
 *   01 ÇEK  → a car drives, a frame is captured looking forward
 *   02 TESPİT → the frame is scanned, assets get bounding boxes + labels
 *   03 KONUM → the detection drops onto the map at its coordinate
 * One shared 8s timeline: every sequenced element bakes its timing into keyframe
 * percentages (NO animation-delay), so the order is exact —
 *   capture → frame.jpg travels → scan+boxes → detections[] travels → pin drops.
 * Pure CSS, GPU transforms, honours prefers-reduced-motion. Colours come from the
 * global brand tokens so the İnovasyon Moru swap flows in.
 */
---

<div class="pipe" role="img" aria-label="RotaAI pipeline: sahada çekim, yapay zeka tespiti, haritaya koordinatlama">
  <div class="pipe__bar">
    <span class="pipe__title">ROTAAI <span class="pipe__slash">//</span> PIPELINE</span>
    <span class="pipe__live"><i class="dot"></i>CANLI</span>
  </div>

  <div class="pipe__stages">
    <!-- 01 ÇEK -->
    <section class="stage">
      <header class="stage__h"><span class="stage__n">01</span> ÇEK</header>
      <svg class="scene" viewBox="0 0 200 150" fill="none" aria-hidden="true">
        <defs>
          <clipPath id="roadclip"><rect x="26" y="52" width="148" height="46" /></clipPath>
          <linearGradient id="coneg" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-brand-400)" stop-opacity="0.55" />
            <stop offset="1" stop-color="var(--color-brand-400)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="200" height="150" fill="var(--color-ink-900)" />
        <!-- road -->
        <rect x="26" y="52" width="148" height="46" fill="var(--color-ink-850)" />
        <line x1="26" y1="52" x2="174" y2="52" stroke="var(--color-ink-700)" stroke-width="1" />
        <line x1="26" y1="98" x2="174" y2="98" stroke="var(--color-ink-700)" stroke-width="1" />
        <!-- scrolling lane line (clipped to the road, implies motion) -->
        <g clip-path="url(#roadclip)">
          <line class="road-dash" x1="-40" y1="75" x2="240" y2="75" stroke="var(--color-ink-500)" stroke-width="2.5" stroke-dasharray="16 18" />
        </g>
        <!-- forward capture cone from the car's front, flashes on capture -->
        <polygon class="cone" points="118,75 158,60 158,90" fill="url(#coneg)" />
        <!-- car (top-down, heading right) -->
        <g class="car">
          <rect x="-18" y="-12" width="36" height="24" rx="6" fill="var(--color-ink-800)" stroke="var(--color-brand-400)" stroke-width="1.5" />
          <rect x="-9" y="-8" width="15" height="16" rx="3" fill="var(--color-brand-500)" opacity="0.5" />
          <line x1="-9" y1="0" x2="6" y2="0" stroke="var(--color-ink-900)" stroke-width="1" />
          <circle cx="15" cy="-6" r="1.7" fill="var(--color-brand-400)" />
          <circle cx="15" cy="6" r="1.7" fill="var(--color-brand-400)" />
        </g>
        <!-- shutter flash overlay (drawn last, over the whole frame) -->
        <rect class="capflash" x="0" y="0" width="200" height="150" fill="var(--color-brand-400)" />
      </svg>
    </section>

    <div class="link"><span class="link__lbl">frame.jpg</span><i class="pkt pkt--1"></i></div>

    <!-- 02 TESPİT -->
    <section class="stage">
      <header class="stage__h"><span class="stage__n">02</span> TESPİT</header>
      <svg class="scene" viewBox="0 0 200 150" fill="none" aria-hidden="true">
        <rect x="0" y="0" width="200" height="80" fill="var(--color-ink-850)" />
        <rect x="0" y="80" width="200" height="70" fill="var(--color-ink-800)" />
        <line x1="0" y1="80" x2="200" y2="80" stroke="var(--color-ink-700)" stroke-width="1" />
        <!-- vanishing road -->
        <polygon points="88,80 112,80 150,150 50,150" fill="var(--color-ink-900)" />
        <line x1="100" y1="80" x2="100" y2="150" stroke="var(--color-ink-600)" stroke-width="1.5" stroke-dasharray="6 8" />
        <!-- asset A: sign on a pole (levha + direk) -->
        <line x1="150" y1="58" x2="150" y2="95" stroke="var(--color-ink-500)" stroke-width="2.5" />
        <polygon points="150,40 160,56 140,56" fill="var(--color-ink-700)" stroke="var(--color-ink-300)" stroke-width="1" />
        <!-- asset B: barrier -->
        <rect x="52" y="70" width="34" height="7" rx="1.5" fill="var(--color-ink-700)" stroke="var(--color-ink-500)" stroke-width="1" />
        <line x1="58" y1="77" x2="58" y2="92" stroke="var(--color-ink-500)" stroke-width="2" />
        <line x1="80" y1="77" x2="80" y2="92" stroke="var(--color-ink-500)" stroke-width="2" />
        <!-- scan line -->
        <rect class="scan" x="0" y="0" width="200" height="2.5" fill="var(--color-brand-400)" />
        <!-- bounding boxes -->
        <rect class="bbox bbox--1" x="135" y="36" width="30" height="62" rx="2" />
        <rect class="bbox bbox--2" x="48" y="66" width="42" height="30" rx="2" />
      </svg>
      <span class="tag tag--1">levha · 0.94</span>
      <span class="tag tag--2">bariyer · 0.88</span>
    </section>

    <div class="link"><span class="link__lbl">detections[]</span><i class="pkt pkt--2"></i></div>

    <!-- 03 KONUM -->
    <section class="stage">
      <header class="stage__h"><span class="stage__n">03</span> KONUM</header>
      <svg class="scene" viewBox="0 0 200 150" fill="none" aria-hidden="true">
        <rect x="0" y="0" width="200" height="150" fill="var(--color-ink-900)" />
        <g stroke="var(--color-ink-800)" stroke-width="1">
          <line x1="0" y1="38" x2="200" y2="38" /><line x1="0" y1="76" x2="200" y2="76" /><line x1="0" y1="114" x2="200" y2="114" />
          <line x1="50" y1="0" x2="50" y2="150" /><line x1="100" y1="0" x2="100" y2="150" /><line x1="150" y1="0" x2="150" y2="150" />
        </g>
        <path d="M0 100 Q 60 90 100 66 T 200 40" stroke="var(--color-ink-700)" stroke-width="2" fill="none" />
        <path d="M20 0 Q 70 60 100 66 T 180 150" stroke="var(--color-ink-700)" stroke-width="1.5" fill="none" />
        <!-- ripple + pin at map centre -->
        <circle class="ripple" cx="100" cy="66" r="6" fill="none" stroke="var(--color-brand-400)" stroke-width="1.5" />
        <g class="pin">
          <path d="M100 46 C112 46 112 62 100 74 C88 62 88 46 100 46 Z" fill="var(--color-brand-500)" stroke="var(--color-brand-400)" stroke-width="1.5" />
          <circle cx="100" cy="57" r="4" fill="var(--color-ink-950)" />
        </g>
      </svg>
      <span class="coord">41.0082, 28.9784 <b>WGS84 ✓</b></span>
    </section>
  </div>

  <p class="pipe__foot">Yakala → sınıflandır → koordinatla. <span>İnsan onaylı.</span></p>
</div>

<style>
  .pipe {
    --loop: 8s;
    border: 1px solid var(--color-ink-700);
    border-radius: 20px;
    background:
      radial-gradient(120% 90% at 85% 0%, color-mix(in oklab, var(--color-brand-600) 14%, transparent), transparent 55%),
      linear-gradient(180deg, var(--color-ink-900), var(--color-ink-950));
    box-shadow: 0 30px 80px -40px color-mix(in oklab, var(--color-brand-500) 55%, transparent);
    overflow: hidden;
  }
  .pipe__bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 18px; border-bottom: 1px solid var(--color-ink-800);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    color: var(--color-ink-300);
  }
  .pipe__slash { color: var(--color-brand-400); }
  .pipe__live { display: inline-flex; align-items: center; gap: 7px; color: var(--color-ink-100); }
  .pipe__live .dot {
    width: 7px; height: 7px; border-radius: 999px; background: var(--color-brand-400);
    box-shadow: 0 0 10px var(--color-brand-400); animation: blink 1.3s steps(1) infinite;
  }

  .pipe__stages {
    display: grid; grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center; gap: 6px; padding: 22px 18px;
  }
  .stage { position: relative; min-width: 0; }
  .stage__h {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
    color: var(--color-ink-300); margin-bottom: 10px;
  }
  .stage__n {
    color: var(--color-ink-950); background: var(--color-brand-400);
    border-radius: 4px; padding: 1px 5px; font-weight: 700; margin-right: 6px;
  }
  .scene {
    width: 100%; height: auto; display: block;
    border: 1px solid var(--color-ink-800); border-radius: 10px; background: var(--color-ink-950);
  }
  .tag, .coord {
    position: absolute; font-family: var(--font-mono); font-size: 10px;
    padding: 2px 7px; border-radius: 5px; white-space: nowrap;
    background: color-mix(in oklab, var(--color-ink-950) 82%, transparent);
    border: 1px solid var(--color-brand-600); color: var(--color-ink-100);
    backdrop-filter: blur(2px);
  }
  .tag--1 { top: 34px; right: 12px; animation: tagIn var(--loop) ease infinite; }
  .tag--2 { top: 92px; left: 12px; animation: tagIn var(--loop) ease infinite; }
  .coord { left: 12px; bottom: 12px; animation: coordIn var(--loop) ease infinite; }
  .coord b { color: var(--color-brand-400); font-weight: 600; }

  /* connector + travelling packet */
  .link {
    position: relative; height: 2px; align-self: center;
    background: repeating-linear-gradient(90deg, var(--color-ink-700) 0 5px, transparent 5px 11px);
    min-width: 40px;
  }
  .link__lbl {
    position: absolute; left: 50%; top: -22px; transform: translateX(-50%);
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em;
    color: var(--color-ink-500); white-space: nowrap;
  }
  .pkt {
    position: absolute; top: 50%; left: 0; width: 8px; height: 8px; margin-top: -4px;
    border-radius: 999px; background: var(--color-brand-400);
    box-shadow: 0 0 12px var(--color-brand-400); opacity: 0;
  }
  .pkt--1 { animation: travel1 var(--loop) linear infinite; }
  .pkt--2 { animation: travel2 var(--loop) linear infinite; }

  /* ---- scene 01 (continuous loops for road + car; capture on master timeline) ---- */
  .road-dash { animation: roadmove 1.1s linear infinite; }
  .car { transform: translate(100px, 75px); transform-box: view-box; animation: carbob 2.6s ease-in-out infinite; }
  .capflash { opacity: 0; animation: capflash var(--loop) linear infinite; }
  .cone { opacity: 0; transform-box: view-box; transform-origin: 118px 75px; animation: cone var(--loop) ease-out infinite; }

  /* ---- scene 02 ---- */
  .scan { opacity: 0; animation: scan var(--loop) ease-in-out infinite; }
  .bbox {
    fill: color-mix(in oklab, var(--color-brand-500) 12%, transparent);
    stroke: var(--color-brand-400); stroke-width: 2;
    stroke-dasharray: 184; stroke-dashoffset: 184; opacity: 0;
  }
  .bbox--1, .bbox--2 { animation: draw var(--loop) ease infinite; }

  /* ---- scene 03 ---- */
  .pin { transform: translateY(-46px); opacity: 0; transform-box: view-box; animation: pin var(--loop) cubic-bezier(.5, 1.6, .5, 1) infinite; }
  .ripple { opacity: 0; transform-box: view-box; transform-origin: 100px 66px; animation: ripple var(--loop) ease-out infinite; }

  /* ===== ONE 8s master timeline. % → seconds: 10% = 0.8s. Order is exact. ===== */
  @keyframes blink { 0%,60%{opacity:1} 61%,100%{opacity:.25} }
  @keyframes roadmove { to { transform: translateX(-34px); } }
  @keyframes carbob { 0%,100%{transform:translate(100px,75px)} 50%{transform:translate(100px,73px)} }

  /* 01 capture — shutter flash + forward cone (~0.3–1.0s) */
  @keyframes capflash { 0%{opacity:0} 4%{opacity:.26} 9%{opacity:0} 100%{opacity:0} }
  @keyframes cone { 0%,2%{opacity:0; transform:scaleX(.3)} 6%{opacity:.9; transform:scaleX(1)} 13%{opacity:0; transform:scaleX(1)} 100%{opacity:0} }

  /* frame.jpg travels 10→22% (0.8–1.76s) */
  @keyframes travel1 { 0%,10%{left:0; opacity:0} 12%{opacity:1} 22%{left:100%; opacity:1} 24%{opacity:0} 100%{left:100%; opacity:0} }

  /* 02 scan sweep 24→40%, boxes draw 26→42% then hold, labels in at 44% */
  @keyframes scan { 0%,24%{transform:translateY(4px); opacity:0} 27%{opacity:.85} 40%{transform:translateY(120px); opacity:.85} 44%{opacity:0} 100%{opacity:0} }
  @keyframes draw {
    0%,26%{stroke-dashoffset:184; opacity:0}
    29%{opacity:1}
    42%{stroke-dashoffset:0; opacity:1}
    70%{opacity:1}
    76%{opacity:0; stroke-dashoffset:0}
    100%{opacity:0}
  }
  @keyframes tagIn { 0%,42%{opacity:0; transform:translateY(4px)} 48%{opacity:1; transform:translateY(0)} 70%{opacity:1} 76%{opacity:0} 100%{opacity:0} }

  /* detections[] travels 45→56% (3.6–4.48s) — AFTER the boxes are drawn */
  @keyframes travel2 { 0%,45%{left:0; opacity:0} 47%{opacity:1} 56%{left:100%; opacity:1} 58%{opacity:0} 100%{left:100%; opacity:0} }

  /* 03 pin drops 56→67% (AFTER detections arrive), coord at 62%, ripple 66→84% */
  @keyframes pin {
    0%,56%{transform:translateY(-46px); opacity:0}
    60%{opacity:1}
    67%{transform:translateY(0)}
    92%{transform:translateY(0); opacity:1}
    98%{opacity:0}
    100%{opacity:0}
  }
  @keyframes coordIn { 0%,62%{opacity:0; transform:translateY(4px)} 67%{opacity:1; transform:translateY(0)} 96%{opacity:1} 99%{opacity:0} 100%{opacity:0} }
  @keyframes ripple { 0%,64%{transform:scale(.2); opacity:0} 68%{opacity:.7} 84%{transform:scale(3.4); opacity:0} 100%{opacity:0} }

  .pipe__foot {
    margin: 0; padding: 12px 18px; border-top: 1px solid var(--color-ink-800);
    font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-500);
  }
  .pipe__foot span { color: var(--color-brand-400); }

  @media (max-width: 760px) {
    .pipe__stages { grid-template-columns: 1fr; gap: 20px; }
    .link { width: 100%; height: 26px; background: none; }
    .link::before {
      content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%);
      background: repeating-linear-gradient(180deg, var(--color-ink-700) 0 5px, transparent 5px 11px);
    }
    .link__lbl { top: 50%; left: calc(50% + 10px); transform: translateY(-50%); }
    .pkt { top: 0; left: 50%; margin-left: -4px; }
    .pkt--1 { animation: travel1v var(--loop) linear infinite; }
    .pkt--2 { animation: travel2v var(--loop) linear infinite; }
    @keyframes travel1v { 0%,10%{top:0; opacity:0} 12%{opacity:1} 22%{top:100%; opacity:1} 24%{opacity:0} 100%{top:100%; opacity:0} }
    @keyframes travel2v { 0%,45%{top:0; opacity:0} 47%{opacity:1} 56%{top:100%; opacity:1} 58%{opacity:0} 100%{top:100%; opacity:0} }
  }

  @media (prefers-reduced-motion: reduce) {
    .road-dash, .car, .capflash, .cone, .scan, .pkt, .pipe__live .dot { animation: none; }
    .capflash, .cone, .pkt, .scan { opacity: 0; }
    .bbox { animation: none; stroke-dashoffset: 0; opacity: 1; }
    .tag, .coord { animation: none; opacity: 1; }
    .pin { animation: none; transform: translateY(0); opacity: 1; }
    .ripple { animation: none; opacity: 0; }
  }
</style>
